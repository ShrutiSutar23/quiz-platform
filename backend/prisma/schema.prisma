generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  @@map("users")
}